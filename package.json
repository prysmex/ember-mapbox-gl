{
  "name": "@prysmex-engineering/ember-mapbox-gl",
  "version": "4.0.0",
  "description": "Ember integration for Mapbox GL JS",
  "keywords": [
    "ember-addon"
  ],
  "homepage": "https://github.com/prysmex/ember-mapbox-gl",
  "repository": "https://github.com/prysmex/ember-mapbox-gl",
  "license": "MIT",
  "author": "Gustavo Rodriguez <gustavo.rodriguez@prysmex.com>",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "start": "vite dev",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0"
  },
  "dependencies": {
    "@ember/render-modifiers": "^4.0.0",
    "@embroider/addon-shim": "^1.8.9",
    "decorator-transforms": "^2.2.2",
    "ember-resources": "^7.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-transform-typescript": "^7.25.2",
    "@babel/runtime": "^7.25.6",
    "@ember/app-tsconfig": "^1.0.0",
    "@ember/library-tsconfig": "^1.0.0",
    "@ember/test-helpers": "^5.2.1",
    "@ember/test-waiters": "^4.1.1",
    "@embroider/addon-dev": "^8.1.0",
    "@embroider/compat": "^4.1.0",
    "@embroider/core": "^4.1.0",
    "@embroider/macros": "^1.20.1",
    "@embroider/vite": "^1.1.5",
    "@eslint/js": "^9.17.0",
    "@glimmer/component": "^2.0.0",
    "@glint/ember-tsc": "^1.0.3",
    "@glint/template": "^1.6.1",
    "@glint/tsserver-plugin": "^2.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@types/qunit": "^2.19.12",
    "@types/sinon": "^22.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.0.1",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.2",
    "ember-source": "^6.7.0",
    "ember-strict-application-resolver": "^0.1.0",
    "ember-template-lint": "^7.9.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-ember": "^13.6.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^16.1.0",
    "mapbox-gl": "^3.24.0",
    "prettier": "^3.4.2",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "publint": "^0.3.16",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.4.0",
    "rollup": "^4.22.5",
    "sinon": "^22.1.0",
    "testem": "^3.15.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^7.1.9"
  },
  "peerDependencies": {
    "mapbox-gl": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20"
  },
  "packageManager": "pnpm@10.34.6",
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./components/mapbox-gl/index.js": "./dist/_app_/components/mapbox-gl/index.js",
      "./components/mapbox-gl/layer.js": "./dist/_app_/components/mapbox-gl/layer.js",
      "./components/mapbox-gl/marker.js": "./dist/_app_/components/mapbox-gl/marker.js",
      "./components/mapbox-gl/popup.js": "./dist/_app_/components/mapbox-gl/popup.js",
      "./components/mapbox-gl/source.js": "./dist/_app_/components/mapbox-gl/source.js",
      "./helpers/mapbox-gl-control.js": "./dist/_app_/helpers/mapbox-gl-control.js",
      "./helpers/mapbox-gl-on.js": "./dist/_app_/helpers/mapbox-gl-on.js",
      "./helpers/mapbox-gl-terrain.js": "./dist/_app_/helpers/mapbox-gl-terrain.js",
      "./services/map-cache.js": "./dist/_app_/services/map-cache.js",
      "./services/mapbox-gl-config.js": "./dist/_app_/services/mapbox-gl-config.js"
    }
  }
}
